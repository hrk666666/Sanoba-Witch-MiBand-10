<template>
  <div class="page">
    <div class="header">
      <text class="title">{{ incomingState ? "保存" : "读取" }}</text>
    </div>

    <!-- 滚动区域 -->
    <scroll scroll-y="true" class="scroll-container">
      <!-- 自动存档槽（置顶，自动专用，只读不可覆盖） -->
      <div class="slot-wrapper" @click="handleAutoSlot">
        <div class="card auto-card {{ autoSaveEntry ? 'full' : 'empty' }}">
          <div if="{{ autoSaveEntry }}" class="card-content">
            <text class="chap-name">自动存档</text>
            <text class="prev-text">{{ autoSaveEntry.preview }}</text>
            <text class="date-text">{{ autoSaveEntry.date }}</text>
          </div>
          <text else style="color: #ffffff; font-size: 14px; line-height: 14px">暂无自动存档</text>
        </div>
      </div>

      <div
        for="{{ (index, item) in saves }}"
        class="slot-wrapper"
        @click="handleClick(index)"
        @longpress="handleDelete(index)"
      >
        <div class="card {{ item ? 'full' : 'empty' }}">
          <div if="{{ item }}" class="card-content">
            <text class="chap-name">{{ item.chapterName }}</text>
            <text class="prev-text">{{ item.preview }}</text>
            <text class="date-text">{{ item.date }}</text>
          </div>

          <!-- 空存档的加号 -->
          <text else style="color: #ffffff; font-size: 36px; line-height: 36px">+</text>
        </div>
      </div>
    </scroll>

    <div class="footer-bar" @click="goBack">
      <text class="footer-text">返回</text>
    </div>
  </div>
</template>

<script>
import storage from "@system.storage"
import router from "@system.router"
import prompt from "@system.prompt"
import {SAVE_KEY, AUTO_SAVE_KEY} from "../../common/constants.js"
import {vibrateShort} from "../../common/vibrate.js"

export default {
  protected: {
    currentState: null
  },

  private: {
    saves: [null, null, null, null, null, null, null, null],
    incomingState: null,
    autoSaveEntry: null
  },

  onInit() {
    if (this.currentState) {
      try {
        this.incomingState =
          typeof this.currentState === "string" ? JSON.parse(this.currentState) : this.currentState
      } catch (e) {
        this.incomingState = null
      }
    }

    this.initData()
  },

  initData() {
    storage.get({
      key: SAVE_KEY,
      success: (data) => {
        if (data) {
          const arr = JSON.parse(data)
          for (let i = 0; i < 8; i++) {
            if (arr[i]) this.saves.splice(i, 1, arr[i])
          }
        }
      }
    })

    // 读取自动存档槽
    storage.get({
      key: AUTO_SAVE_KEY,
      success: (data) => {
        if (data) {
          try {
            this.autoSaveEntry = JSON.parse(data)
          } catch (e) {
            this.autoSaveEntry = null
          }
        }
      }
    })
  },

  handleClick(index) {
    vibrateShort()
    if (this.incomingState) {
      this.doSave(index)
    } else if (this.saves[index]) {
      this.doLoad(index)
    } else {
      prompt.showToast({message: "存档位为空"})
    }
  },

  // 自动存档槽：只读（可读，不可手动覆盖/删除）
  handleAutoSlot() {
    vibrateShort()
    if (this.incomingState) {
      prompt.showToast({message: "自动存档不可手动覆盖"})
    } else if (this.autoSaveEntry) {
      this.doLoadAuto()
    } else {
      prompt.showToast({message: "暂无自动存档"})
    }
  },

  doSave(index) {
    if (!this.incomingState) return

    const rawText = this.incomingState.fullText
    let previewContent = "..."

    if (this.incomingState.fullText) {
      previewContent = rawText.length > 10 ? rawText.substring(0, 10) + "..." : rawText
    }

    const now = new Date()

    const month = now.getMonth() + 1
    const day = now.getDate()
    const hour = now.getHours().toString().padStart(2, "0")
    const min = now.getMinutes().toString().padStart(2, "0")
    const dateStr = `${month}/${day} ${hour}:${min}`

    const entry = {
      date: dateStr,
      chapterName: this.incomingState.chapterName,
      preview: previewContent,
      gameState: this.incomingState
    }

    this.saves.splice(index, 1, entry)

    storage.set({
      key: SAVE_KEY,
      value: JSON.stringify(this.saves),
      success: () => prompt.showToast({message: "保存成功"})
    })
  },

  doLoad(index) {
    // 手动槽读取进入：禁用自动保存（不覆盖自动槽），仍手动保存
    this.$app.$def.globalGameState = this.saves[index].gameState
    this.$app.$def.globalGameState._fromLoad = true

    router.replace({
      uri: "pages/game"
    })
  },

  // 自动存档读取：等同继续游戏，自动保存保持启用
  doLoadAuto() {
    this.$app.$def.globalGameState = this.autoSaveEntry.gameState

    router.replace({
      uri: "pages/game"
    })
  },

  handleDelete(index) {
    vibrateShort()
    if (!this.saves[index]) return

    this.saves.splice(index, 1, null)

    storage.set({key: SAVE_KEY, value: JSON.stringify(this.saves)})

    prompt.showToast({message: "删除成功"})
  },

  goBack() {
    vibrateShort()
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  background-color: #1d1d1d;
  width: 100%;
  height: 100%;
}

.header {
  height: 44px;
  justify-content: center;
  align-items: center;
}

.title {
  color: #cf89f8;
  font-size: 17px;
  font-weight: bold;
}

.scroll-container {
  flex: 1;
  flex-direction: column;
}

.slot-wrapper {
  width: 100%;
  padding: 5px 0;
  justify-content: center;
}

.card {
  width: 88%;
  min-height: 68px;
  background-color: #cf89f8;
  border-radius: 12px;
  padding: 8px;
  justify-content: center;
  align-items: center;
}

/* 自动存档槽：紫色高亮边框，标识自动专用 */
.auto-card {
  background-color: rgba(207, 137, 248, 0.35);
  border: 1px solid #cf89f8;
}

.card-content {
  flex-direction: column;
  width: 100%;
  align-items: center;
}

.chap-name {
  color: #000000;
  font-size: 14px;
  font-weight: bold;
  margin-bottom: 2px;
}

.prev-text {
  color: #1a1a1a;
  font-size: 12px;
  lines: 1;
  margin-bottom: 2px;
}

.date-text {
  color: #444444;
  font-size: 11px;
}

.footer-bar {
  height: 54px;
  background-color: #333333;
  margin: 8px;
  border-radius: 15px;
  justify-content: center;
  align-items: center;
}

.footer-text {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
}
</style>
