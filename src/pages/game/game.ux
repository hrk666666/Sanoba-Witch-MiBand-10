<!-- 魔女的夜宴 × VN 引擎（v1.1）— 立绘三槽位 / BGM / 特效 / 存档槽位 -->
<template>
  <div class="page" @click="handleScreenClick" @swipe="handleSwipe" @longpress="handleLongPress">
    <image class="bg-image" src="{{ '/common/bg/' + currentBg + '.jpg' }}"></image>

    <!-- 立绘三槽位（内容包 ch/ 提供 PNG 时显示；缺失时该槽自动空出） -->
    <image
      if="{{ characters.left }}"
      class="sprite sprite-left {{ characters.left.action }}"
      src="{{ '/common/ch/' + characters.left.key + '.png' }}"
    ></image>
    <image
      if="{{ characters.center }}"
      class="sprite sprite-center {{ characters.center.action }}"
      src="{{ '/common/ch/' + characters.center.key + '.png' }}"
    ></image>
    <image
      if="{{ characters.right }}"
      class="sprite sprite-right {{ characters.right.action }}"
      src="{{ '/common/ch/' + characters.right.key + '.png' }}"
    ></image>

    <!-- EV 事件图（内容包 ev/ 提供时显示） -->
    <image
      class="ev-image"
      if="{{ currentEV }}"
      src="{{ '/common/ev/' + currentEV + '.jpg' }}"
    ></image>

    <!-- SD 差分图 -->
    <image
      class="sd-image"
      if="{{ currentSD }}"
      src="{{ '/common/sd/' + currentSD + '.jpg' }}"
    ></image>

    <!-- 特效层（whiteflash/blackout/fadein/fadeout） -->
    <div class="fx-overlay {{ fxClass }}" if="{{ fxActive }}"></div>

    <div class="dialogue-layer" if="{{ !isLoading && !isSkipping && !showOptions && !isUIHidden }}">
      <div class="speaker-box" if="{{ currentSpeaker }}">
        <text class="speaker-text">{{ currentSpeaker }}</text>
      </div>

      <div class="dialogue-box">
        <scroll scroll-y="true" class="scroll-view" id="dialogueScroll">
          <text
            class="typewriter-text"
            style="font-size: {{ settings.textSize }}px; line-height: {{ settings.textSize * 1.3 }}px;"
          >
            {{ displayText }}
          </text>
        </scroll>
      </div>
    </div>

    <!-- 选项按钮 -->
    <div class="options-overlay" if="{{ showOptions && !isUIHidden }}">
      <div class="options-container">
        <div
          for="{{ (index, item) in currentOptions }}"
          class="option-button"
          @click="handleOptionClick(index)"
        >
          <text class="option-text">{{ item.text }}</text>
        </div>
      </div>
    </div>

    <!-- 控制层（隐藏UI / 快进） -->
    <div class="control-layer" @click="stopClick">
      <div class="control-button" @click="toggleUIVisibility">
        <text class="control-button-text">{{ isUIHidden ? "显示" : "隐藏" }}</text>
      </div>

      <div
        class="control-button"
        onlongpress="doFastForward"
        ontouchend="stopFastForward"
        if="{{ !isUIHidden }}"
      >
        <text class="control-button-text">快进</text>
      </div>
    </div>

    <!-- 侧滑/长按菜单 -->
    <div class="menu-overlay" if="{{ showSwipeMenu }}">
      <image
        class="bg-image"
        style="opacity: 0.4"
        src="{{ '/common/bg/' + currentBg + '.jpg' }}"
      ></image>

      <div class="menu-container" @click="stopClick">
        <text class="menu-time">{{ currentTime }}</text>
        <text class="menu-title">菜单</text>

        <div class="menu-grid">
          <div class="menu-button" @click="saveGame">
            <text class="menu-button-text">保存进度</text>
          </div>
          <div class="menu-button" @click="routeLoad">
            <text class="menu-button-text">读取进度</text>
          </div>
          <div class="menu-button" @click="skipToOptions">
            <text class="menu-button-text">跳过到下一个选项</text>
          </div>
          <div class="menu-button" @click="returnToHome">
            <text class="menu-button-text">返回主页</text>
          </div>
          <div class="menu-button close-button" @click="closeMenu">
            <text class="menu-button-text">返回游戏</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { DEBUG, SETTINGS_KEY } from "../../common/constants.js"
import { createVnEngine } from "../../engine/index.js"
import { createAiotAdapter } from "../../engine/platformAdapter.js"

import storage from "@system.storage"
import router from "@system.router"
import prompt from "@system.prompt"

const DEFAULT_BG = "空_青空"

export default {
  private: {
    // ---- 引擎状态（onState 同步）----
    currentBg: DEFAULT_BG,
    currentEV: "",
    currentSD: "",
    currentSpeaker: "",
    fullText: "",
    currentChapterName: "",
    characters: { left: null, center: null, right: null },
    currentOptions: [],
    showOptions: false,
    isTextComplete: false,
    isFastForwarding: false,
    isSkipping: false,
    ended: false,

    // ---- UI 状态 ----
    displayText: "",
    currentCharIndex: 0,
    showSwipeMenu: false,
    currentTime: "00:00",
    isUIHidden: false,
    isLoading: true,
    typeWriterTimer: null,
    fxActive: false,
    fxClass: "",
    _fxTimer: null,

    // ---- 引擎实例（不参与模板渲染）----
    _engine: null,
    _rt: null,
    _pendingRestore: null,

    // 设置（窄屏适配：默认字号 18）
    settings: {
      textSpeed: 40,
      textSize: 18
    }
  },

  // ---------- 生命周期 ----------

  onInit() {
    // 读取系统设置（文字速度、字号）
    storage.get({
      key: SETTINGS_KEY,
      success: (data) => {
        if (data) {
          try {
            const parsed = JSON.parse(data)
            this.settings.textSpeed = parsed.textSpeed
            this.settings.textSize = parsed.textSize
          } catch (e) { /* 解析失败用默认值 */ }
        }
      }
    })

    this.bootEngine()
  },

  onShow() {
    const stateToLoad = this.$app.$def.globalGameState
    if (stateToLoad) {
      this.$app.$def.globalGameState = null
      this._pendingRestore = stateToLoad
      if (this._rt) {
        this.doRestore(stateToLoad)
      }
    } else if (this._rt && !this._rt.scnId) {
      // 首次进入：从内容包默认场景开始
      this.loadDefault()
    }
  },

  onHide() {
    this.clearTimer()
  },

  onDestroy() {
    this.clearTimer()
    if (this._fxTimer) clearTimeout(this._fxTimer)
    if (this._rt) this._rt.destroy()
  },

  /** 创建引擎实例（异步，就绪后处理挂起的读档/默认进度） */
  async bootEngine() {
    try {
      const adapter = createAiotAdapter()
      this._engine = await createVnEngine({
        adapter,
        options: { saveSlots: 4 },
        onState: (s) => this.syncState(s),
        onFx: (name) => this.playFx(name)
      })
      this._rt = this._engine.runtime
      if (this._pendingRestore) {
        this.doRestore(this._pendingRestore)
        this._pendingRestore = null
      } else {
        this.loadDefault()
      }
    } catch (e) {
      this.isLoading = false
      this.displayText = "引擎初始化失败: " + (e && e.message)
      if (DEBUG) console.error("[Game/Engine] boot 失败: " + e.message)
    }
  },

  loadDefault() {
    this.isLoading = true
    this._rt.load("001").catch((e) => {
      this.isLoading = false
      this.displayText = "加载失败: " + (e && e.message)
    })
  },

  /** 引擎状态 → 页面展示字段 */
  syncState(s) {
    this.currentBg = s.bg || DEFAULT_BG
    this.currentEV = s.ev || ""
    this.currentSD = s.sd || ""
    this.currentSpeaker = s.speaker || ""
    this.currentChapterName = s.chapterName || ""
    this.characters = s.characters || { left: null, center: null, right: null }
    this.currentOptions = s.options || []
    this.showOptions = s.showOptions
    this.isFastForwarding = s.isFastForwarding
    this.isSkipping = s.isSkipping
    this.ended = s.ended
    this.isLoading = false

    // 对话文本：新一句 → 打字机；完成态 → 直接全文
    const newLine = s.fullText !== this.fullText || !s.isTextComplete
    this.fullText = s.fullText || ""
    if (s.isTextComplete) {
      this.clearTimer()
      this.displayText = this.fullText
      this.isTextComplete = true
    } else if (newLine) {
      this.isTextComplete = false
      this.currentCharIndex = 0
      this.displayText = ""
      this.startTypeWriter()
    }
  },

  // ---------- 打字机 ----------

  startTypeWriter() {
    this.clearTimer()
    const scroll = this.$element("dialogueScroll")
    if (scroll && this.currentCharIndex === 0) {
      scroll.scrollTo({ top: 0, behavior: "instant" })
    }

    if (this.currentCharIndex < this.fullText.length) {
      this.displayText += this.fullText.charAt(this.currentCharIndex)
      this.currentCharIndex++
      const speed = this.isFastForwarding ? 2 : this.settings.textSpeed

      this.typeWriterTimer = setTimeout(() => this.startTypeWriter(), speed)

      if (this.currentCharIndex % 5 === 0 && this.displayText.length > 20) {
        const sc = this.$element("dialogueScroll")
        if (sc) sc.scrollTo({ top: 9999, behavior: "instant" })
      }
    } else {
      // 打字完成 → 通知引擎全文可见
      this.clearTimer()
      this.displayText = this.fullText
      this.isTextComplete = true
      if (this._rt) this._rt.markTextComplete()
    }
  },

  // ---------- 点击/推进 ----------

  handleScreenClick() {
    if (this.showSwipeMenu || this.isLoading || this.showOptions) return

    if (this.isUIHidden) {
      this.toggleUIVisibility()
      return
    }

    if (this.isSkipping) {
      if (!this.showOptions) this._rt.skipToNextSelect()
      return
    }

    if (!this.isTextComplete) {
      // 打字中点击 → 直接显示全文
      this.clearTimer()
      this.displayText = this.fullText
      this.isTextComplete = true
      if (this._rt) this._rt.markTextComplete()
    } else {
      this._rt.advance()
    }
  },

  handleOptionClick(index) {
    const opt = this.currentOptions[index]
    if (!opt) return
    this.showOptions = false
    this._rt.choose(index)
  },

  // ---------- 快进/跳过 ----------

  doFastForward() {
    if (this._rt) this._rt.doFastForward()
  },

  stopFastForward() {
    if (this._rt) this._rt.stopFastForward()
  },

  skipToOptions() {
    this.closeMenu()
    if (this._rt) this._rt.skipToNextSelect()
  },

  // ---------- 存档/读档 ----------

  /** 保存进度：构造引擎存档数据，跳存档页选择槽位 */
  saveGame() {
    if (!this._rt) return
    const currentState = this._rt.save()
    this.closeMenu()
    router.push({
      uri: "pages/data",
      params: { currentState: currentState }
    })
  },

  routeLoad() {
    this.closeMenu()
    router.push({ uri: "pages/data" })
  },

  /** 恢复引擎存档（来自 pages/data 读档或跨页面返回） */
  async doRestore(saved) {
    this.isLoading = true
    try {
      await this._rt.restore(saved)
      this.isLoading = false
    } catch (e) {
      this.isLoading = false
      this.displayText = "读档失败: " + (e && e.message)
      if (DEBUG) console.error("[Game/IO] 读档失败: " + e.message)
    }
  },

  // ---------- 特效 ----------

  playFx(name) {
    const map = {
      whiteflash: "fx-whiteflash",
      blackout: "fx-blackout",
      fadein: "fx-fadein",
      fadeout: "fx-fadeout"
    }
    const cls = map[name]
    if (!cls) return

    if (this._fxTimer) clearTimeout(this._fxTimer)
    this.fxClass = cls
    this.fxActive = true
    // 动画时长后自动移除（200ms 白闪 / 400ms 黑场淡入淡出）
    const ms = name === "whiteflash" ? 200 : 500
    this._fxTimer = setTimeout(() => {
      this.fxActive = false
      this.fxClass = ""
      this._fxTimer = null
    }, ms)
  },

  // ---------- UI 菜单 ----------

  handleSwipe() {
    this.showSwipeMenu = true
    const now = new Date()
    this.currentTime =
      now.getHours().toString().padStart(2, "0") +
      ":" +
      now.getMinutes().toString().padStart(2, "0")
  },

  handleLongPress() {
    this.handleSwipe()
  },

  closeMenu(event) {
    if (event && event.stopPropagation) event.stopPropagation()
    this.showSwipeMenu = false
  },

  stopClick(event) {
    if (event && event.stopPropagation) event.stopPropagation()
  },

  toggleUIVisibility() {
    this.isUIHidden = !this.isUIHidden
  },

  returnToHome() {
    router.replace({ uri: "pages/index" })
  },

  clearTimer() {
    if (this.typeWriterTimer) {
      clearTimeout(this.typeWriterTimer)
      this.typeWriterTimer = null
    }
  }
}
</script>

<style>
.page {
  flex-direction: column;
  position: absolute;
  width: 100%;
  height: 100%;
}

.bg-image {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1; /* 最底层 */
}

/* 立绘三槽位：绝对定位，z-index 2-4（高于背景低于 SD/对话框） */
.sprite {
  position: absolute;
  bottom: 0;
  z-index: 3;
}

.sprite-left {
  left: 0;
  height: 78%;
}

.sprite-center {
  left: 50%;
  height: 100%;
  transform: translateX(-50%);
}

.sprite-right {
  right: 0;
  height: 78%;
}

/* 立绘动作动画（@keyframes 支持 opacity/transform） */
.sprite.fadein {
  animation: char-fadein 300ms ease-out;
}

.sprite.fadeout {
  animation: char-fadeout 300ms ease-in;
}

.sprite.change {
  animation: char-fadein 200ms ease-out;
}

@keyframes char-fadein {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes char-fadeout {
  from { opacity: 1; }
  to { opacity: 0; }
}

.ev-image {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 5;
}

.sd-image {
  position: absolute;
  width: 151px;
  height: 91px;
  left: 30px;
  top: 40px;
  z-index: 5;
}

/* 特效层：覆盖全屏，靠透明度动画呈现白闪/黑场 */
.fx-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 40;
  pointer-events: none;
}

.fx-whiteflash {
  background-color: #ffffff;
  animation: fx-fade-out 200ms ease-out;
}

.fx-blackout {
  background-color: #000000;
  animation: fx-fade-out 500ms ease-out;
}

.fx-fadein {
  background-color: #000000;
  animation: fx-fade-in 500ms ease-out;
}

.fx-fadeout {
  background-color: #000000;
  animation: fx-fade-out 500ms ease-out;
}

@keyframes fx-fade-in {
  from { opacity: 1; }
  to { opacity: 0; }
}

@keyframes fx-fade-out {
  from { opacity: 1; }
  to { opacity: 0; }
}

.dialogue-layer {
  flex-direction: column;
  justify-content: flex-end;
  padding: 8px;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.speaker-box {
  position: absolute;
  bottom: 160px;
  left: 8px;
  right: 8px;
  background-color: rgba(207, 137, 248, 0.8);
  padding: 4px 10px;
  border-radius: 6px;
  margin-bottom: 3px;
  align-self: flex-start;
}

.speaker-text {
  font-size: 15px;
  color: #ffffff;
  font-weight: bold;
}

.dialogue-box {
  position: absolute;
  bottom: 20px;
  left: 8px;
  right: 8px;
  height: 120px;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
}

.scroll-view {
  width: 100%;
  height: 100%;
  flex-wrap: wrap;
  padding: 10px;
}

.typewriter-text {
  width: 100%;
  color: #ffffff;
  text-align: left;
  padding: 0;
  margin: 0;
}

.menu-overlay {
  position: absolute;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  z-index: 30;
  background-color: rgba(0, 0, 0, 0.8);
}

.menu-container {
  width: 85%;
  padding: 12px;
  background-color: rgba(0, 0, 0, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  flex-direction: column;
  align-items: center;
}

.menu-title {
  color: #cf89f8;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 10px;
}

.menu-grid {
  flex-direction: column;
  width: 100%;
}

.menu-button {
  width: 100%;
  height: 46px;
  margin-bottom: 10px;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  justify-content: center;
  align-items: center;
}

.close-button {
  background-color: rgba(207, 137, 248, 0.3);
  margin-top: 6px;
}

.menu-button-text {
  color: #ffffff;
  font-size: 15px;
}

.menu-time {
  color: #ffffff;
  font-size: 12px;
  text-align: center;
  margin-bottom: 6px;
}

.options-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 10px;
  z-index: 20;
  background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.6) 100%);
}

.options-container {
  width: 85%;
  display: flex;
  flex-direction: column;
}

.option-button {
  width: 100%;
  background-color: rgba(207, 137, 248, 0.8);
  padding: 14px;
  margin: 5px 0;
  border-radius: 8px;
  justify-content: center;
  border: 1px solid rgba(207, 137, 248, 0.6);
}

.option-text {
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
  text-align: center;
}

.control-layer {
  position: absolute;
  top: 6px;
  left: 0;
  right: 0;
  flex-direction: column;
  align-items: center;
  z-index: 15;
}

.control-button {
  padding: 8px 16px;
  margin-bottom: 8px;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 6px;
  justify-content: center;
  align-items: center;
}

.control-button-text {
  color: #ffffff;
  font-size: 14px;
}
</style>
