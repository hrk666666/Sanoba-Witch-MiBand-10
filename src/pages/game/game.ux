<!-- 上游 1.1.2+ 新引擎（快进/EV/SD/隐藏UI）+ 手环 9/10/11 窄屏适配（designWidth 212）
     1.3.0：自动保存/自动播放/屏幕常亮/纯黑模式/振动反馈/上一句/时间显示/字号放大等 -->
<template>
  <div
    class="page"
    @click="handleScreenClick"
    @swipe="handleSwipe"
    ontouchstart="pageTouchStart"
    ontouchmove="pageTouchMove"
    ontouchend="pageTouchEnd"
  >
    <image class="bg-image" if="{{ !settings.darkMode }}" src="{{ '/common/bg/' + currentBg + '.jpg' }}"></image>

    <!-- EV 事件图（feature/ev 分支未完成，保留渲染层） -->
    <image
      class="ev-image"
      if="{{ currentEV && !settings.darkMode }}"
      src="{{ '/common/ev/' + currentEV + '.jpg' }}"
    ></image>

    <!-- SD 事件图（原图尺寸 240x144，超屏可左右拖动；层级与背景同级） -->
    <image
      class="sd-image"
      if="{{ currentSD && !settings.darkMode }}"
      src="{{ '/common/sd/' + currentSD + '.jpg' }}"
      style="left: {{ sdLeft }}px; top: {{ sdTop }}px"
      ontouchstart="sdTouchStart"
      ontouchmove="sdTouchMove"
      ontouchend="sdTouchEnd"
      @click="stopClick"
    ></image>

    <div class="dialogue-layer" if="{{ !isLoading && !isSkipping && !showOptions && !isUIHidden }}">
      <!-- 对话框部分（说话人与打字机） -->
      <div class="speaker-box" if="{{ currentSpeaker }}">
        <text class="speaker-text">{{ currentSpeaker }}</text>
        <!-- 上一句按钮：与顶部控制按钮同款构造，放在人名旁 -->
        <div class="prev-line-button" @click="goToPrevLine">
          <text class="prev-line-text">上一句</text>
        </div>
      </div>

      <div class="dialogue-box">
        <scroll scroll-y="true" class="scroll-view" id="dialogueScroll">
          <text
            class="typewriter-text"
            style="font-size: {{ settings.textSize }}px; line-height: {{ settings.textSize * 1.3 }}px; font-weight: {{ settings.boldText ? 'bold' : 'normal' }};"
          >
            {{ displayText }}
          </text>
        </scroll>
      </div>

      <!-- 底部居中时间（字号与人名一致 15px） -->
      <text class="bottom-time">{{ bottomTime }}</text>
    </div>

    <!-- 选项按钮 -->
    <div class="options-overlay" if="{{ showOptions && !isUIHidden }}">
      <div class="options-container">
        <div
          for="{{ (index, item) in currentOptions }}"
          class="option-button"
          @click="handleOptionClick(item[1], item[2])"
        >
          <text class="option-text">{{ item[0] }}</text>
        </div>
      </div>
    </div>

    <!-- 控制层（隐藏UI / 快进，快进改用触摸计时防误触） -->
    <div class="control-layer" @click="stopClick">
      <div class="control-button" @click="toggleUIVisibility">
        <text class="control-button-text">{{ isUIHidden ? "显示" : "隐藏" }}</text>
      </div>

      <div
        class="control-button"
        ontouchstart="ffTouchStart"
        ontouchmove="ffTouchMove"
        ontouchend="ffTouchEnd"
        if="{{ !isUIHidden }}"
      >
        <text class="control-button-text">快进</text>
      </div>
    </div>

    <!-- 侧滑/长按菜单部分 -->
    <div class="menu-overlay" if="{{ showSwipeMenu }}">
      <!-- 暗化背景（纯黑模式不渲染图片） -->
      <image
        class="bg-image"
        if="{{ !settings.darkMode }}"
        style="opacity: 0.4"
        src="{{ '/common/bg/' + currentBg + '.jpg' }}"
      ></image>

      <!-- 容器与按钮 -->
      <div class="menu-container" @click="stopClick">
        <text class="menu-time">{{ currentTime }}</text>

        <text class="menu-title">菜单</text>

        <scroll scroll-y="true" class="menu-scroll">
          <div class="menu-grid">
            <div class="menu-button" @click="saveGame">
              <text class="menu-button-text">保存进度</text>
            </div>
            <div class="menu-button" @click="routeLoad">
              <text class="menu-button-text">读取进度</text>
            </div>
            <div class="menu-button" @click="skipToOptions">
              <text class="menu-button-text">跳过到下一个选项</text>
            </div>
            <div class="menu-button {{ isAutoPlay ? 'auto-on' : '' }}" @click="toggleAutoPlay">
              <text class="menu-button-text">{{ isAutoPlay ? "自动播放：开" : "自动播放：关" }}</text>
            </div>
            <div class="menu-button" @click="returnToHome">
              <text class="menu-button-text">返回主页</text>
            </div>
            <div class="menu-button close-button" @click="closeMenu">
              <text class="menu-button-text">返回游戏</text>
            </div>
          </div>
        </scroll>
      </div>
    </div>
  </div>
</template>

<script>
import {DEBUG, SCN_TYPE, SCN_LIST, SETTINGS_KEY, AUTO_SAVE_KEY} from "../../common/constants.js"
import engine from "./scriptEngine.js"
import {vibrateShort} from "../../common/vibrate.js"

import storage from "@system.storage"
import file from "@system.file"
import router from "@system.router"
import prompt from "@system.prompt"
import brightness from "@system.brightness"

// 自动保存节流间隔（ms）：进度实时但写入限频，避免频繁擦写存储
const AUTO_SAVE_INTERVAL = 3000
// 自动播放间隔（ms）
const AUTO_PLAY_DELAY = 500
// 长按阈值（ms）：比系统默认更长，避免回退操作时误触
const LONG_PRESS_DELAY = 600
// SD 图宽超出屏宽的最大可拖偏移（240 - 212 = 28）
const SD_MAX_LEFT = 0
const SD_MIN_LEFT = -28

export default {
  private: {
    // 剧本有关
    scriptData: [],
    currentScnId: "001",
    currentLineIndex: 0,
    currentCharIndex: 0,

    // 游戏有关
    displayText: "",
    fullText: "",
    currentSpeaker: "",
    currentBg: "空_青空",
    currentEV: "",
    currentSD: "",
    currentChapterName: "",
    currentCharacters: [],
    gameFlags: {},

    // UI有关
    showSwipeMenu: false,
    currentTime: "00:00",
    isUIHidden: false,
    isTextComplete: false,
    isFastForwarding: false,
    typeWriterTimer: null,
    fastForwardTimer: null,

    // 底部时间
    bottomTime: "00:00",
    bottomTimeTimer: null,

    // 自动播放
    isAutoPlay: false,
    autoPlayTimer: null,

    // 自动保存
    autoSaveEnabled: true,
    lastAutoSaveAt: 0,

    // 长按（自定义触摸计时，防误触）
    pageTouched: false,
    pageMoved: false,
    pageLongTimer: null,
    ffTouched: false,
    ffMoved: false,
    ffLongPressTimer: null,
    menuJustOpened: false,

    // SD 图拖动
    sdLeft: -14,
    sdTop: 40,
    sdDragStartX: 0,
    sdDragStartLeft: 0,
    sdDragMoved: false,

    // 选项有关
    currentOptions: [],
    showOptions: false,

    // 状态与设置（窄屏适配：默认字号 22 = 原 18 的 1.25 倍）
    isLoading: true,
    isSkipping: false,
    settings: {
      textSpeed: 40,
      textSize: 22,
      boldText: true,
      autoSave: true,
      keepScreenOn: false,
      darkMode: false,
      vibration: true
    }
  },

  // 导入的方法
  ...engine,

  onDestroy() {
    this.clearTimer()
    this.clearFastForwardTimer()
    this.clearAutoPlayTimer()
    this.clearPageLongTimer()
    this.clearFFLongPressTimer()
    this.stopBottomTime()

    // 离开阅读页时关闭常亮
    try {
      brightness.setKeepScreenOn({ keepScreenOn: false })
    } catch (e) {}
  },

  onHide() {
    this.clearTimer()
    this.clearFastForwardTimer()
    this.clearAutoPlayTimer()
    this.clearPageLongTimer()
    this.clearFFLongPressTimer()
    this.stopBottomTime()
  },

  onInit() {
    // 读取系统设置（音量、文字速度等）
    storage.get({
      key: SETTINGS_KEY,
      success: (data) => {
        if (data) {
          try {
            const parsed = JSON.parse(data)
            Object.assign(this.settings, parsed)
            if (DEBUG) console.log("[Game/System] 设置加载成功")
          } catch (e) {
            if (DEBUG) console.error("[Game/System] 解析设置失败")
          }
        }
      }
    })
  },

  // 监听页面显示，尝试从全局状态恢复进度
  onShow() {
    const stateToLoad = this.$app.$def.globalGameState

    // 从「读取」（手动存档槽）进入时禁用自动保存，仍靠手动保存
    this.autoSaveEnabled = !(stateToLoad && stateToLoad._fromLoad)
    if (stateToLoad && stateToLoad._fromLoad) {
      delete stateToLoad._fromLoad
    }

    if (stateToLoad) {
      if (DEBUG) console.log("[Game/IO] 恢复存档状态:", stateToLoad)

      // 读取存档内容
      const targetScnId = stateToLoad.currentScnId || "001"
      const targetIndex = parseInt(stateToLoad.currentLineIndex, 10) || 0
      const targetBg = stateToLoad.currentBg
      const targetChapterName = stateToLoad.currentChapterName
      const targetGameFlags = stateToLoad.gameFlags

      if (targetChapterName) {
        this.currentChapterName = targetChapterName
      }

      if (targetGameFlags) {
        this.gameFlags = targetGameFlags
      }

      // 清除全局变量防止重复触发
      this.$app.$def.globalGameState = null

      this.clearTimer()
      this.clearFastForwardTimer()
      this.clearAutoPlayTimer()

      // 加载剧本并跳转到对应行
      this.loadScenario(targetScnId, targetIndex, targetBg)
    } else {
      // 如果没有存档状态，且当前没在播放剧本，则加载默认进度
      if (!this.scriptData || this.scriptData.length === 0) {
        this.loadScenario(this.currentScnId, this.currentLineIndex)
      }
    }

    // 应用屏幕常亮（自动播放或常亮开关）
    this.applyKeepScreenOn()
    this.startBottomTime()
  },

  getNextScn(currentId) {
    if (currentId === "020_nene") return SCN_LIST.nene[0]
    if (currentId === "020_meguru") return SCN_LIST.meguru[0]
    if (currentId === "020_tsumugi") return SCN_LIST.tsumugi[0]
    if (currentId === "020_akogare") return SCN_LIST.akogare[0]

    // 查找共通线
    const commonList = SCN_LIST.common
    const commonIdx = commonList.findIndex((i) => i.id === currentId)

    if (commonIdx !== -1) {
      // 共通线 019 结束时
      if (currentId === "019") {
        const route = this.determineRoute() // 获取得分最高的角色ID

        switch (route) {
          case "nene":
            return commonList.find((i) => i.id === "020_nene")
          case "meguru":
            return commonList.find((i) => i.id === "020_meguru")
          case "tsumugi":
            return commonList.find((i) => i.id === "020_tsumugi")
          case "akogare":
            return commonList.find((i) => i.id === "020_akogare")
          case "wakana":
            return SCN_LIST.wakana[0] // 和奏直接进 500
          default:
            return commonList[commonIdx + 1]
        }
      }

      // 普通共通线顺序推进
      return commonList[commonIdx + 1] || null
    }

    // 遍历所有个人线，查找当前 ID 的下一章
    const routes = ["nene", "meguru", "tsumugi", "akogare", "wakana"]
    for (const route of routes) {
      const list = SCN_LIST[route]
      if (!list) continue
      const index = list.findIndex((i) => i.id === currentId)
      if (index !== -1) {
        return list[index + 1] || null // 没有下一章则 null
      }
    }

    // 完全找不到，返回 null
    return null
  },

  async loadScenario(id, startIndex = 0, savedBg = null) {
    this.isLoading = true

    this.clearTimer()
    this.clearFastForwardTimer()
    this.clearAutoPlayTimer()

    try {
      const fileName = this.getPathById(id)
      if (!fileName) throw new Error(`未找到ID: ${id}`)

      // 调用上面的读取函数
      const result = await this.readJsonFile(fileName)

      // 处理数据格式
      this.scriptData = Array.isArray(result) ? result : result.content || []

      this.currentScnId = id
      this.currentLineIndex = parseInt(startIndex, 10)

      if (savedBg) {
        if (DEBUG) console.log("[Game/IO] 应用存档背景: " + savedBg)
        this.currentBg = savedBg
      }

      this.isLoading = false

      if (DEBUG) console.log(`[Game/IO] ${id} 加载成功，startIndex: ${startIndex}`)

      this.showLine()
    } catch (error) {
      this.isLoading = false
      this.displayText = "错误: " + error.message
      if (DEBUG) console.error("[Game/IO] 场景加载失败: " + error.message)
    }
  },

  // 封装 file.readText 为 Promise
  readJsonFile(fileName) {
    return new Promise((resolve, reject) => {
      file.readText({
        uri: `/common/scn/${fileName}`,
        success: (data) => {
          try {
            const jsonData = JSON.parse(data.text)
            resolve(jsonData)
          } catch (e) {
            reject(new Error(`JSON解析失败: ${e.message}`))
          }
        },
        fail: (error) => {
          reject(new Error(`文件读取失败: ${error.code}`))
        }
      })
    })
  },

  goToNextScenario() {
    const next = this.getNextScn(this.currentScnId, this.userSelectedRoute || "common")

    if (next) {
      if (DEBUG) console.log(`[Game/Engine] 准备进入下一章节: ${next.name}`)
      this.currentScnId = next.id
      this.loadScenario(next.id)
    } else {
      if (DEBUG) console.warn("[Game/Engine] 未找到后续章节，结束")
      prompt.showToast({message: "游戏结束"})
    }
  },

  showTypeWriterEffect() {
    this.clearTimer()

    if (this.currentCharIndex === 0) {
      const scroll = this.$element("dialogueScroll")
      if (scroll) {
        scroll.scrollTo({top: 0, behavior: "instant"})
      }
    }

    if (this.currentCharIndex < this.fullText.length) {
      this.displayText += this.fullText.charAt(this.currentCharIndex)
      this.currentCharIndex++
      const speed = this.isFastForwarding ? 2 : this.settings.textSpeed

      this.typeWriterTimer = setTimeout(() => {
        this.showTypeWriterEffect()
      }, speed)

      if (this.currentCharIndex % 5 === 0 && this.displayText.length > 20) {
        const scroll = this.$element("dialogueScroll")
        if (scroll) {
          scroll.scrollTo({top: 9999, behavior: "instant"})
        }
      }
    } else {
      this.finishText()
    }
  },

  /*
      剧本有关（解析剧本等）
  */
  // 解析表达式
  runExp(expStr) {
    if (!expStr) return
    if (DEBUG) console.log("[Game/System] 执行表达式: " + expStr)

    // 按照逗号拆分多条指令 (如 "f.sel_flag=0, f.wak_flag++")
    const parts = expStr.split(",")

    parts.forEach((part) => {
      let cmd = part.trim()
      try {
        if (cmd.includes("++")) {
          // 处理自增: f.wak_flag ++
          const varName = cmd.replace("f.", "").replace("++", "").trim()
          this.gameFlags[varName] = (this.gameFlags[varName] || 0) + 1
        } else if (cmd.includes("--")) {
          // 处理自减: f.wak_flag -- (其实不知道有没有这种 保险起见还是写上去了)
          const varName = cmd.replace("f.", "").replace("--", "").trim()
          this.gameFlags[varName] = (this.gameFlags[varName] || 0) - 1
        } else if (cmd.includes("=")) {
          // 处理赋值: f.sel_flag = 1
          let [varName, val] = cmd.split("=")
          varName = varName.replace("f.", "").trim()
          val = val.trim()

          // 尝试转数字，转不了则存字符串
          const numVal = parseInt(val)
          this.gameFlags[varName] = isNaN(numVal) ? val : numVal
        }
      } catch (e) {
        console.error("[Game/System] Exp解析出错: " + cmd + " 错误信息: " + e.message)
      }
    })

    if (DEBUG) console.log("[Game/System] 同步后变量库: ", JSON.stringify(this.gameFlags))
  },

  // 通过gameFlag确定进入哪条线
  determineRoute() {
    const flags = this.gameFlags
    const flagScores = [
      {id: "nene", score: flags.nen_flag || 0},
      {id: "meguru", score: flags.meg_flag || 0},
      {id: "tsumugi", score: flags.tsu_flag || 0},
      {id: "akogare", score: flags.tou_flag || 0},
      {id: "wakana", score: flags.wak_flag || 0}
    ]

    // 按分数从高到低排序
    flagScores.sort((a, b) => b.score - a.score)

    // 获取分数最高的角色ID，如果最高分是0，单身
    if (flagScores[0].score === 0) {
      if (DEBUG) console.log("[Game/Engine] 好感度均为0，单身")
      return null
    }

    // 若有两个或以上角色的好感度相同，单身
    if (flagScores[0].score === flagScores[1].score) {
      if (DEBUG) {
        console.log(
          `[Game/Engine] 存在两个或以上好感度相同的角色：${flagScores[0].id}(${flagScores[0].score})/${flagScores[1].id}(${flagScores[1].score})，单身`
        )
      }

      return null
    }

    if (DEBUG) console.log(`[Game/Engine] 进入 ${flagScores[0].id} 线`)

    return flagScores[0].id
  },

  // 根据ID获取剧本路径
  getPathById(id) {
    for (const category of Object.values(SCN_LIST)) {
      const scene = category.find((item) => item.id === id)
      if (scene) return scene.path
    }
    return undefined
  },

  // 跳过章节
  skipToOptions() {
    this.closeMenu()
    this.skipUntilSelect()
  },

  finishText() {
    this.clearTimer()
    this.displayText = this.fullText
    this.isTextComplete = true

    // 自动播放：整句完整显示后等待 AUTO_PLAY_DELAY 自动进入下一句
    if (this.isAutoPlay && !this.showOptions && !this.isSkipping && !this.isFastForwarding) {
      this.clearAutoPlayTimer()
      this.autoPlayTimer = setTimeout(() => {
        this.autoPlayNext()
      }, AUTO_PLAY_DELAY)
    }
  },

  // 保存进度
  saveGame() {
    this.vibrateIfEnabled()

    // 构造当前游戏状态
    const currentState = {
      currentScnId: this.currentScnId,
      currentLineIndex: this.currentLineIndex,
      currentBg: this.currentBg,
      currentSpeaker: this.currentSpeaker,
      currentChapterName: this.currentChapterName,
      gameFlags: this.gameFlags,
      fullText: this.fullText
    }

    this.closeMenu()

    // 跳转到 data 页面，并把传入当前状态
    router.push({
      uri: "pages/data",
      params: {currentState: currentState}
    })
  },

  /*
      自动保存（节流实时写入）
  */
  maybeAutoSave() {
    if (!this.autoSaveEnabled) return
    if (!this.settings || this.settings.autoSave === false) return

    const now = Date.now()
    if (now - this.lastAutoSaveAt < AUTO_SAVE_INTERVAL) return

    this.writeAutoSave()
    this.lastAutoSaveAt = now
  },

  // 退出/返回主页时强制执行一次自动保存
  forceAutoSave() {
    if (!this.autoSaveEnabled) return
    if (!this.settings || this.settings.autoSave === false) return

    this.writeAutoSave()
    this.lastAutoSaveAt = Date.now()
  },

  writeAutoSave() {
    const currentState = {
      currentScnId: this.currentScnId,
      currentLineIndex: this.currentLineIndex,
      currentBg: this.currentBg,
      currentSpeaker: this.currentSpeaker,
      currentChapterName: this.currentChapterName,
      gameFlags: this.gameFlags,
      fullText: this.fullText
    }

    const rawText = this.fullText || ""
    let previewContent = "..."
    if (rawText) {
      previewContent = rawText.length > 10 ? rawText.substring(0, 10) + "..." : rawText
    }

    const now = new Date()
    const month = now.getMonth() + 1
    const day = now.getDate()
    const hour = now.getHours().toString().padStart(2, "0")
    const min = now.getMinutes().toString().padStart(2, "0")
    const dateStr = `${month}/${day} ${hour}:${min}`

    const entry = {
      date: dateStr,
      chapterName: this.currentChapterName,
      preview: previewContent,
      gameState: currentState
    }

    storage.set({key: AUTO_SAVE_KEY, value: JSON.stringify(entry)})
  },

  /*
      UI相关（点击/侧滑事件等）
  */
  handleScreenClick() {
    // 长按唤菜单刚结束时的误点击，吞掉防止同时翻句
    if (this.menuJustOpened) {
      this.menuJustOpened = false
      return
    }

    if (this.showSwipeMenu || this.isLoading || this.showOptions) return

    // 任意点击触发振动反馈
    this.vibrateIfEnabled()

    // UI隐藏时点击屏幕显示UI
    if (this.isUIHidden) {
      this.toggleUIVisibility()
      return
    }

    if (this.isSkipping) {
      // 快进时，遇到选项已经暂停，如果用户再次点击（其实选项已弹出不会走到这），
      // 但以防万一,如果不在选项状态则继续快进
      if (!this.showOptions) {
        this.skipUntilSelect()
      }
      return
    }

    if (!this.isTextComplete) {
      this.finishText()
    } else {
      // 手动点击时取消自动播放计时，立即翻句
      this.clearAutoPlayTimer()

      if (this.currentLineIndex < this.scriptData.length - 1) {
        this.currentLineIndex++
        this.showLine()
      } else {
        if (DEBUG) console.info("[Game/Engine] 当前章节结束，尝试进入下一章")
        this.goToNextScenario()
      }
    }
  },

  handleOptionClick(targetLabel, exp) {
    this.vibrateIfEnabled()
    this.showOptions = false

    if (exp) {
      this.runExp(exp)
    }

    const targetIndex = this.scriptData.findIndex(
      (item) => item[0] === SCN_TYPE.LABEL && item[1] === targetLabel
    )

    if (targetIndex !== -1) {
      this.currentLineIndex = targetIndex
      // 如果之前是快进模式，选项选择后继续快进
      if (this.isSkipping) {
        this.skipUntilSelect()
      } else {
        this.showLine()
      }
    } else {
      if (DEBUG) console.error("[Game/Engine] 未找到选项跳转标签: " + targetLabel)
      prompt.showToast({message: `未找到标签: ${targetLabel}`})
      this.showOptions = true
    }
  },

  closeMenu(event) {
    // 阻止事件冒泡
    if (event && event.stopPropagation) {
      event.stopPropagation()
    }

    this.showSwipeMenu = false
  },

  // 跳转到存档页
  routeLoad() {
    this.vibrateIfEnabled()
    router.push({
      uri: "pages/data"
    })
  },

  // 阻止点击穿透，防止在侧滑时触发下一句
  stopClick(event) {
    // 拦截容器内的所有点击，不让它传到 page 层
    if (event && event.stopPropagation) {
      event.stopPropagation()
    }
  },

  handleSwipe() {
    this.showSwipeMenu = true

    const now = new Date()
    this.currentTime =
      now.getHours().toString().padStart(2, "0") +
      ":" +
      now.getMinutes().toString().padStart(2, "0")
  },

  toggleUIVisibility() {
    this.isUIHidden = !this.isUIHidden
    if (DEBUG) console.log("[Game/UI] UI可见性切换: isUIHidden: " + this.isUIHidden)
  },

  returnToHome() {
    // 退出阅读前强制保存一次
    const willAutoSave = this.autoSaveEnabled && this.settings && this.settings.autoSave !== false
    this.forceAutoSave()

    this.clearAutoPlayTimer()
    this.stopBottomTime()

    if (willAutoSave) {
      prompt.showToast({message: "进度已自动保存"})
    }

    router.replace({uri: "pages/index"})
  },

  clearTimer() {
    if (this.typeWriterTimer) {
      clearTimeout(this.typeWriterTimer)
      this.typeWriterTimer = null
    }
  },

  /*
      自动播放
  */
  toggleAutoPlay() {
    this.vibrateIfEnabled()
    this.isAutoPlay = !this.isAutoPlay

    // 自动播放开启时同步启用屏幕常亮
    this.applyKeepScreenOn()

    if (this.isAutoPlay) {
      prompt.showToast({message: "自动播放已开启"})
    } else {
      this.clearAutoPlayTimer()
      prompt.showToast({message: "自动播放已关闭"})
    }

    this.closeMenu()
  },

  /*
      上一句
  */
  goToPrevLine(event) {
    if (event && event.stopPropagation) event.stopPropagation()
    this.vibrateIfEnabled()

    if (!this.scriptData || this.scriptData.length === 0) return

    let idx = this.currentLineIndex - 1
    while (idx >= 0) {
      if (this.scriptData[idx] && this.scriptData[idx][0] === SCN_TYPE.DIALOGUE) break
      idx--
    }

    if (idx < 0) {
      prompt.showToast({message: "已是第一句"})
      return
    }

    this.currentLineIndex = idx
    this.clearAutoPlayTimer()
    this.showLine()
  },

  /*
      屏幕常亮
  */
  applyKeepScreenOn() {
    const on = this.isAutoPlay || (this.settings && this.settings.keepScreenOn)
    try {
      brightness.setKeepScreenOn({keepScreenOn: !!on})
    } catch (e) {}
  },

  /*
      底部时间
  */
  startBottomTime() {
    this.stopBottomTime()
    this.updateBottomTime()
    this.bottomTimeTimer = setInterval(() => {
      this.updateBottomTime()
    }, 30000)
  },

  stopBottomTime() {
    if (this.bottomTimeTimer) {
      clearInterval(this.bottomTimeTimer)
      this.bottomTimeTimer = null
    }
  },

  updateBottomTime() {
    const now = new Date()
    this.bottomTime =
      now.getHours().toString().padStart(2, "0") +
      ":" +
      now.getMinutes().toString().padStart(2, "0")
  },

  /*
      振动反馈
  */
  vibrateIfEnabled() {
    if (this.settings && this.settings.vibration === false) return
    vibrateShort()
  },

  /*
      长按：自定义触摸计时（阈值 LONG_PRESS_DELAY，移动即取消）
  */
  pageTouchStart() {
    this.pageTouched = true
    this.pageMoved = false
    this.clearPageLongTimer()

    this.pageLongTimer = setTimeout(() => {
      if (
        this.pageTouched &&
        !this.pageMoved &&
        !this.showSwipeMenu &&
        !this.showOptions &&
        !this.isLoading
      ) {
        this.menuJustOpened = true
        this.handleSwipe()
      }
    }, LONG_PRESS_DELAY)
  },

  pageTouchMove() {
    this.pageMoved = true
    this.clearPageLongTimer()
  },

  pageTouchEnd() {
    this.pageTouched = false
    this.clearPageLongTimer()
  },

  clearPageLongTimer() {
    if (this.pageLongTimer) {
      clearTimeout(this.pageLongTimer)
      this.pageLongTimer = null
    }
  },

  /*
      快进按钮：触摸计时触发（不再用系统 longpress，避免回退误触）
  */
  ffTouchStart(event) {
    if (event && event.stopPropagation) event.stopPropagation()
    if (this.showOptions) return

    this.ffTouched = true
    this.ffMoved = false
    this.clearFFLongPressTimer()

    this.ffLongPressTimer = setTimeout(() => {
      if (this.ffTouched && !this.ffMoved) {
        this.doFastForward()
      }
    }, LONG_PRESS_DELAY)
  },

  ffTouchMove(event) {
    if (event && event.stopPropagation) event.stopPropagation()
    this.ffMoved = true
    this.clearFFLongPressTimer()
    this.stopFastForward()
  },

  ffTouchEnd(event) {
    if (event && event.stopPropagation) event.stopPropagation()
    this.ffTouched = false
    this.clearFFLongPressTimer()
    this.stopFastForward()
  },

  clearFFLongPressTimer() {
    if (this.ffLongPressTimer) {
      clearTimeout(this.ffLongPressTimer)
      this.ffLongPressTimer = null
    }
  },

  /*
      SD 插图：原图尺寸显示、与背景同级、支持左右拖动
  */
  sdTouchStart(event) {
    if (event && event.stopPropagation) event.stopPropagation()
    const touch = event.touches && event.touches[0]
    this.sdDragStartX = touch ? touch.clientX : 0
    this.sdDragStartLeft = this.sdLeft
    this.sdDragMoved = false
  },

  sdTouchMove(event) {
    if (event && event.stopPropagation) event.stopPropagation()
    const touch = event.touches && event.touches[0]
    if (!touch) return

    this.sdDragMoved = true
    const delta = touch.clientX - this.sdDragStartX
    let nextLeft = this.sdDragStartLeft + delta
    nextLeft = Math.max(SD_MIN_LEFT, Math.min(SD_MAX_LEFT, nextLeft))
    this.sdLeft = nextLeft
  },

  sdTouchEnd() {
    this.sdDragMoved = false
  }
}
</script>

<style>
.page {
  flex-direction: column;
  position: absolute;
  width: 100%;
  height: 100%;
}

.bg-image {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 1; /* 最底层 */
}

.ev-image {
  position: absolute;
  width: 100%;
  height: 100%;
  z-index: 5; /* 层级高于背景 */
}

/* SD 图按原图 240x144 尺寸显示（超出屏宽 212，可左右拖动查看），层级与背景同级 */
.sd-image {
  position: absolute;
  width: 240px;
  height: 144px;
  z-index: 1;
}

.dialogue-layer {
  flex-direction: column;
  justify-content: flex-end;
  padding: 8px;
  width: 100%;
  height: 100%;

  z-index: 10;
}

/* 说话人行：人名 + 上一句按钮（同顶部控制按钮构造） */
.speaker-box {
  position: absolute;
  bottom: 190px; /* 跟随对话框（150px 高）上移 */
  left: 12px;
  right: 12px;

  flex-direction: row;
  align-items: center;
  justify-content: space-between;

  background-color: rgba(207, 137, 248, 0.8);
  padding: 6px 12px;

  border-radius: 6px;
  margin-bottom: 3px;
}

.speaker-text {
  font-size: 15px;
  color: #ffffff;
  font-weight: bold;
}

.prev-line-button {
  padding: 6px 12px;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 6px;
  justify-content: center;
  align-items: center;
}

.prev-line-text {
  color: #ffffff;
  font-size: 14px;
}

.dialogue-box {
  position: absolute;

  bottom: 20px;
  left: 12px;
  right: 12px;

  height: 150px; /* 原 120px 的 1.25 倍 */

  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 10px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  display: flex;
}

.scroll-view {
  width: 100%;
  height: 100%;

  /* 开启多行排列，允许内容向下延伸 */
  flex-wrap: wrap;
  padding: 14px;
}

.typewriter-text {
  /* 强制占满父宽，同时锁定左侧对齐起点 */
  width: 100%;

  color: #ffffff;
  text-align: left;
  padding: 0;
  margin: 0;
}

/* 底部居中时间（字号与人名一致 15px） */
.bottom-time {
  position: absolute;
  bottom: 2px;
  left: 0;
  right: 0;
  text-align: center;
  color: rgba(255, 255, 255, 0.75);
  font-size: 15px;
}

.menu-overlay {
  position: absolute;
  width: 100%;
  height: 100%;

  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;

  z-index: 30;
  background-color: rgba(0, 0, 0, 0.8);
}

/* 菜单容器（内容可滚动，容纳更多按钮） */
.menu-container {
  width: 85%;
  height: 85%;
  padding: 12px;
  background-color: rgba(0, 0, 0, 0.85);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  flex-direction: column;
  align-items: center;
}

.menu-title {
  color: #cf89f8;
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 10px;
}

.menu-scroll {
  width: 100%;
  flex: 1;
  flex-direction: column;
}

.menu-grid {
  flex-direction: column;
  width: 100%;
}

/* 按钮样式（字号 15 -> 19，1.25 倍） */
.menu-button {
  width: 100%;
  height: 50px;
  margin-bottom: 8px;
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  justify-content: center;
  align-items: center;
}

.auto-on {
  background-color: rgba(207, 137, 248, 0.5);
}

.close-button {
  background-color: rgba(207, 137, 248, 0.3);
  margin-top: 6px;
}

.menu-button-text {
  color: #ffffff;
  font-size: 19px;
}

.menu-time {
  color: #ffffff;
  font-size: 12px;
  text-align: center;
  margin-bottom: 6px;
}

/* 选项部分 */
.options-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 10px;
  z-index: 20;

  background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.6) 100%);
}

.options-container {
  width: 85%;
  display: flex;
  flex-direction: column;
}

.option-button {
  width: 100%;
  background-color: rgba(207, 137, 248, 0.8);
  padding: 14px;
  margin: 5px 0;
  border-radius: 8px;
  justify-content: center;
  border: 1px solid rgba(207, 137, 248, 0.6);
}

.option-text {
  color: #ffffff;
  font-size: 15px;
  font-weight: 700;
  text-align: center;
}

/* 控制层（快进按钮 1.25 倍） */
.control-layer {
  position: absolute;
  top: 6px;
  left: 0;
  right: 0;
  flex-direction: column;
  align-items: center;
  z-index: 15;
}

.control-button {
  padding: 10px 20px;
  margin-bottom: 8px;
  background-color: rgba(0, 0, 0, 0.3);
  border-radius: 6px;
  justify-content: center;
  align-items: center;
}

.control-button-text {
  color: #ffffff;
  font-size: 18px;
}
</style>
