<template>
  <div class="page" @swipe="handleSwipe">
    <!-- 背景（纯黑模式不渲染图片） -->
    <image class="bg-image" if="{{ !settings.darkMode }}" src="/common/title_bg.jpg"></image>

    <!-- 顶部标题区 -->
    <div class="header">
      <text class="header-title">魔女的夜宴</text>
    </div>

    <!-- 药丸卡片列表 -->
    <scroll scroll-y="true" class="list">
      <div class="item" @click="routeContinue">
        <text class="itemtext">继续游戏</text>
        <image class="arrow" src="/common/images/enter.png"></image>
      </div>
      <div class="item" @click="routeGame">
        <text class="itemtext">重开</text>
        <image class="arrow" src="/common/images/enter.png"></image>
      </div>
      <div class="item" @click="routeLoad">
        <text class="itemtext">载入进度</text>
        <image class="arrow" src="/common/images/enter.png"></image>
      </div>
      <div class="item" @click="routeSetting">
        <text class="itemtext">系统设定</text>
        <image class="arrow" src="/common/images/enter.png"></image>
      </div>
      <div class="item" @click="routeAbout">
        <text class="itemtext">关于本篇</text>
        <image class="arrow" src="/common/images/enter.png"></image>
      </div>
      <div class="item item-danger" @click="exitApp">
        <text class="itemtext itemtext-danger">退出游戏</text>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import storage from "@system.storage"
import {DEBUG, SETTINGS_KEY, AUTO_SAVE_KEY} from "../../common/constants.js"
import {vibrateShort} from "../../common/vibrate.js"

export default {
  data: {
    isNavigating: false,
    navTimer: null,
    settings: {
      darkMode: false,
      vibration: true
    }
  },

  onInit() {
    this.isNavigating = false
    this.clearNavTimer()

    storage.get({
      key: SETTINGS_KEY,
      success: (data) => {
        if (data) {
          try {
            const parsed = JSON.parse(data)
            Object.assign(this.settings, parsed)
            if (DEBUG) console.log("[Index] 设置加载成功")
          } catch (e) {}
        }
      }
    })
  },

  onShow() {
    this.isNavigating = false
    this.clearNavTimer()
  },

  clearNavTimer() {
    if (this.navTimer) {
      clearTimeout(this.navTimer)
      this.navTimer = null
    }
  },

  vibrateIfEnabled() {
    if (this.settings && this.settings.vibration === false) return
    vibrateShort()
  },

  routeContinue() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()

    const done = () => {
      this.navTimer = setTimeout(() => {
        this.isNavigating = false
      }, 2000)
    }

    storage.get({
      key: AUTO_SAVE_KEY,
      success: (data) => {
        if (data) {
          try {
            const entry = JSON.parse(data)
            if (entry && entry.gameState) {
              this.$app.$def.globalGameState = entry.gameState
              router.push({uri: "/pages/game"})
              done()
              return
            }
          } catch (e) {}
        }
        prompt.showToast({message: "暂无自动存档"})
        done()
      },
      fail: () => {
        prompt.showToast({message: "暂无自动存档"})
        done()
      }
    })
  },

  routeGame() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    router.push({uri: "/pages/game"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  routeLoad() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    router.push({uri: "/pages/data"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  routeSetting() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    router.push({uri: "/pages/settings"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  routeAbout() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    router.push({uri: "/pages/about"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  exitApp() {
    this.vibrateIfEnabled()
    try {
      this.$app.exit()
    } catch (e) {
      prompt.showToast({message: "无法退出"})
    }
  },

  handleSwipe() {}
}
</script>

<style>
.page {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

.header {
  position: absolute;
  top: 20px;
  width: 100%;
  height: 44px;
  justify-content: center;
  align-items: center;
}

.header-title {
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}

.list {
  position: absolute;
  top: 80px;
  left: 12px;
  right: 12px;
  bottom: 16px;
  flex-direction: column;
}

.item {
  width: 100%;
  height: 56px;
  margin-bottom: 8px;
  padding: 0 18px;
  background-color: #262626;
  border-radius: 26px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.item:active {
  background-color: #333333;
}

.itemtext {
  font-size: 23px;
  font-weight: bold;
  color: #ffffff;
}

.arrow {
  width: 24px;
  height: 24px;
}

.item-danger {
  background-color: rgba(255, 59, 48, 0.15);
}

.itemtext-danger {
  color: #ff3b30;
}
</style>
