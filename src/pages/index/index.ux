<template>
  <div class="page" @swipe="handleSwipe">
    <!-- 背景（纯黑模式不渲染图片） -->
    <image class="bg-image" if="{{ !settings.darkMode }}" src="/common/title_bg.jpg"></image>

    <!-- 按钮区域 - flex 自适应布局（手环 9/10/11 通吃） -->
    <div class="button-container">
      <stack class="stack-button" @click="routeContinue">
        <text class="text-button text-shadow">继续游戏</text>
        <text class="text-button">继续游戏</text>
      </stack>
      <stack class="stack-button" @click="routeGame">
        <text class="text-button text-shadow">重开</text>
        <text class="text-button">重开</text>
      </stack>
      <stack class="stack-button" @click="routeLoad">
        <text class="text-button text-shadow">载入进度</text>
        <text class="text-button">载入进度</text>
      </stack>
      <stack class="stack-button" @click="routeSetting">
        <text class="text-button text-shadow">系统设定</text>
        <text class="text-button">系统设定</text>
      </stack>
      <stack class="stack-button" @click="routeAbout">
        <text class="text-button text-shadow">关于本篇</text>
        <text class="text-button">关于本篇</text>
      </stack>
      <stack class="stack-button" @click="exitApp">
        <text class="text-button text-shadow">退出游戏</text>
        <text class="text-button">退出游戏</text>
      </stack>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import prompt from "@system.prompt"
import storage from "@system.storage"
import {DEBUG, SETTINGS_KEY, AUTO_SAVE_KEY} from "../../common/constants.js"
import {vibrateShort} from "../../common/vibrate.js"

export default {
  data: {
    isNavigating: false,
    navTimer: null,
    settings: {
      darkMode: false,
      vibration: true
    }
  },

  onInit() {
    this.isNavigating = false
    this.clearNavTimer()

    storage.get({
      key: SETTINGS_KEY,
      success: (data) => {
        if (data) {
          try {
            const parsed = JSON.parse(data)
            Object.assign(this.settings, parsed)
            if (DEBUG) console.log("[Index] 设置加载成功")
          } catch (e) {}
        }
      }
    })
  },

  onShow() {
    this.isNavigating = false
    this.clearNavTimer()
  },

  clearNavTimer() {
    if (this.navTimer) {
      clearTimeout(this.navTimer)
      this.navTimer = null
    }
  },

  vibrateIfEnabled() {
    if (this.settings && this.settings.vibration === false) return
    vibrateShort()
  },

  // 继续游戏：读取自动存档直接进入
  routeContinue() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()

    const done = () => {
      this.navTimer = setTimeout(() => {
        this.isNavigating = false
      }, 2000)
    }

    storage.get({
      key: AUTO_SAVE_KEY,
      success: (data) => {
        if (data) {
          try {
            const entry = JSON.parse(data)
            if (entry && entry.gameState) {
              this.$app.$def.globalGameState = entry.gameState
              router.push({uri: "/pages/game"})
              done()
              return
            }
          } catch (e) {}
        }
        prompt.showToast({message: "暂无自动存档"})
        done()
      },
      fail: () => {
        prompt.showToast({message: "暂无自动存档"})
        done()
      }
    })
  },

  routeGame() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    if (DEBUG) console.info("[Index] 跳转到游戏页面")
    router.push({uri: "/pages/game"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  routeLoad() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    if (DEBUG) console.info("[Index] 跳转到加载数据页面")
    router.push({uri: "/pages/data"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  routeSetting() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    if (DEBUG) console.info("[Index] 跳转到设置页面")
    router.push({uri: "/pages/settings"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  routeAbout() {
    if (this.isNavigating) return
    this.isNavigating = true
    this.vibrateIfEnabled()
    if (DEBUG) console.info("[Index] 跳转到关于页面")
    router.push({uri: "/pages/about"})
    this.navTimer = setTimeout(() => { this.isNavigating = false }, 2000)
  },

  exitApp() {
    this.vibrateIfEnabled()
    try {
      this.$app.exit()
    } catch (e) {
      prompt.showToast({message: "无法退出"})
    }
  },

  handleSwipe() {}
}
</script>

<style>
.page {
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.bg-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  top: 0;
  left: 0;
}

.button-container {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 10px;
}

.stack-button {
  width: 172px;
  height: 48px;
  margin: 5px 0;
  justify-content: center;
  align-items: center;
}

.text-button {
  font-weight: bold;
  font-size: 21px; /* 原 17px 的 1.25 倍 */
  color: rgb(188, 72, 253);
  text-align: center;
}

.text-shadow {
  position: absolute;
  color: #000000;
  opacity: 0.6;
  margin-top: 1px;
  margin-left: 1px;
}
</style>
