<template>
  <div class="page" @swipe="handleSwipe">
    <!-- 无图版：不渲染背景图，底色纯黑 -->

    <!-- 顶部按钮：保存/退出 居中并排、间距缩小 -->
    <div class="top-buttons">
      <text class="text-button" @click="saveSettings">保存</text>
      <text class="text-button" @click="back">退出</text>
    </div>

    <!-- 设置项（可滚动） -->
    <scroll scroll-y="true" class="scroll-container">
      <text class="label-text">速度 ({{ settings.textSpeed }}ms)</text>
      <slider
        class="slider"
        min="20"
        max="100"
        step="5"
        value="{{ settings.textSpeed }}"
        @change="changeTextSpeed"
      ></slider>

      <text class="label-text">大小 ({{ settings.textSize }}px)</text>
      <slider
        class="slider"
        min="10"
        max="30"
        step="1"
        value="{{ settings.textSize }}"
        @change="changeTextSize"
      ></slider>

      <!-- 功能开关 -->
      <div class="switch-row" @click="toggleBoldText">
        <text class="switch-label">文字加粗</text>
        <text class="switch-value">{{ settings.boldText ? "开" : "关" }}</text>
      </div>
      <div class="switch-row" @click="toggleAutoSave">
        <text class="switch-label">自动保存</text>
        <text class="switch-value">{{ settings.autoSave ? "开" : "关" }}</text>
      </div>
      <div class="switch-row" @click="toggleKeepScreenOn">
        <text class="switch-label">屏幕常亮</text>
        <text class="switch-value">{{ settings.keepScreenOn ? "开" : "关" }}</text>
      </div>
      <div class="switch-row" @click="toggleVibration">
        <text class="switch-label">振动反馈</text>
        <text class="switch-value">{{ settings.vibration ? "开" : "关" }}</text>
      </div>
    </scroll>

    <!-- 对话框与打字机预览 -->
    <div class="dialogue-box">
      <scroll scroll-y="true" class="scroll-view" id="dialogueScroll">
        <text
          class="typewriter-text"
          style="font-size: {{ settings.textSize }}px; line-height: {{ settings.textSize * 1.2 }}px; font-weight: {{ settings.boldText ? 'bold' : 'normal' }};"
        >
          {{ displayText }}
        </text>
      </scroll>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import {DEBUG, SETTINGS_KEY} from "../../common/constants.js"
import {vibrateShort} from "../../common/vibrate.js"

export default {
  data: {
    text: "Sanoba Witch\n文字显示速度展示\n0d000721",
    displayText: "",
    currentCharIndex: 0,

    settings: {
      textSpeed: 40,
      textSize: 22,
      boldText: true,
      autoSave: true,
      keepScreenOn: false,
      darkMode: true, /* 无图版恒纯黑 */
      vibration: true
    }
  },

  onInit() {
    this.timer = null

    const that = this

    storage.get({
      key: SETTINGS_KEY,

      success: (data) => {
        if (data) {
          try {
            if (DEBUG) console.log("[Settings] 原始设置数据: " + data)

            const parsed = JSON.parse(data)
            Object.assign(that.settings, parsed)
          } catch (e) {
            if (DEBUG) console.error("[Settings] JSON解析出错: " + e.message)
          }
        } else {
          if (DEBUG) console.log("[Settings] 未读取到缓存数据，使用默认设置")
        }

        this.showTypeWriterEffect()
      }
    })
  },

  showTypeWriterEffect() {
    if (this.timer) clearTimeout(this.timer)

    if (this.currentCharIndex === 0) {
      this.$element("dialogueScroll").scrollTo({
        top: 0,
        behavior: "instant"
      })
    }

    if (this.currentCharIndex < this.text.length) {
      this.displayText += this.text.charAt(this.currentCharIndex)
      this.currentCharIndex++

      this.timer = setTimeout(() => {
        this.showTypeWriterEffect()
      }, this.settings.textSpeed)

      if (this.currentCharIndex % 5 === 0 && this.displayText.length > 20) {
        this.$element("dialogueScroll").scrollTo({
          top: 9999,
          behavior: "instant"
        })
      }
    } else {
      this.timer = setTimeout(() => {
        this.currentCharIndex = 0
        this.displayText = ""
        this.showTypeWriterEffect()
      }, 2000)
    }
  },

  saveSettings() {
    vibrateShort()
    const setting = JSON.stringify(this.settings)
    storage.set({
      key: SETTINGS_KEY,
      value: JSON.stringify(this.settings),

      success: () => {
        if (DEBUG) console.info("[Settings] 设置保存成功: " + setting)
        this.back()
      },

      fail: () => {
        if (DEBUG) console.error("[Settings] 设置保存失败")
      }
    })
  },

  changeTextSpeed(e) {
    const value = e.progress !== undefined ? e.progress : e.value
    if (value !== undefined) {
      this.settings.textSpeed = value
    }
  },

  changeTextSize(e) {
    const value = e.progress !== undefined ? e.progress : e.value
    if (value !== undefined) {
      this.settings.textSize = value
    }
  },

  toggleBoldText() {
    this.settings.boldText = !this.settings.boldText
    vibrateShort()
  },

  toggleAutoSave() {
    this.settings.autoSave = !this.settings.autoSave
    vibrateShort()
  },

  toggleKeepScreenOn() {
    this.settings.keepScreenOn = !this.settings.keepScreenOn
    vibrateShort()
  },

  toggleDarkMode() {
    this.settings.darkMode = !this.settings.darkMode
    vibrateShort()
  },

  toggleVibration() {
    this.settings.vibration = !this.settings.vibration
    vibrateShort()
  },

  handleSwipe() {},

  onDestroy() {
    if (this.timer) {
      clearTimeout(this.timer)
      this.timer = null
    }
  },

  back() {
    vibrateShort()
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  position: absolute;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.top-buttons {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  height: 54px;
}

.text-button {
  width: 64px;
  height: 30px;
  margin: 0 6px;
  font-weight: bold;
  font-size: 14px;
  text-align: center;
  border-radius: 4px;
  background-color: rgba(188, 72, 253, 0.2);
  border: 1px solid rgb(188, 72, 253);
  color: rgb(240, 200, 255);
}

.scroll-container {
  flex: 1;
  flex-direction: column;
  padding: 0 15px;
  padding-bottom: 150px; /* 给底部预览框留空间 */
}

.label-text {
  font-size: 15px;
  color: #ffffff;
  font-weight: bold;
  margin-top: 12px;
}

.slider {
  height: 24px;
  width: 100%;
  selected-color: rgb(188, 72, 253);
  block-color: rgb(188, 72, 253);
  color: rgb(207, 137, 248);
}

.switch-row {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 46px;
  margin-top: 4px;
  padding: 0 4px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.15);
}

.switch-label {
  color: #ffffff;
  font-size: 15px;
  font-weight: bold;
}

.switch-value {
  color: rgb(207, 137, 248);
  font-size: 15px;
  font-weight: bold;
}

.dialogue-box {
  position: absolute;
  bottom: 20px;
  left: 8px;
  right: 8px;
  height: 110px;
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 8px;
  display: flex;
}

.scroll-view {
  width: 100%;
  height: 100%;
  flex-wrap: wrap;
}

.typewriter-text {
  width: 100%;
  color: #ffffff;
  text-align: left;
  padding: 0;
  margin: 0;
}
</style>
